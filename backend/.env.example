GOOGLE_CLOUD_PROJECT=finance-tracker-6329d
# Absolute path to a service account JSON in ignored backend/credentials/ or outside the repo.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/firebase-admin.json
# Docker Compose worker: the same absolute path on the host.
FIREBASE_CREDENTIALS_FILE=/absolute/path/to/firebase-admin.json
# Optional: set to the host user's UID/GID if the key is readable only by that user.
BACKEND_UID=10001
BACKEND_GID=10001

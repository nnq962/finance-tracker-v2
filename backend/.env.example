# For running the API or worker outside Docker (see README.md).
GOOGLE_CLOUD_PROJECT=finance-tracker-6329d
# Absolute path to a service account JSON in ignored backend/credentials/ or outside the repo.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/firebase-admin.json
# PostgreSQL as the finance_app role (same value as web/.env.local).
DATABASE_URL=postgres://finance_app:<APP_DB_PASSWORD>@127.0.0.1:5432/finance

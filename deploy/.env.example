# Copy to deploy/.env (never commit it). In dev, `npm run db:up` creates it
# with random passwords automatically.

# Owner of the schema; used only by migrations and backups.
POSTGRES_PASSWORD=change-me
# The role the app connects as (row read/write only).
APP_DB_PASSWORD=change-me

# Dev only: host port for Postgres on 127.0.0.1.
POSTGRES_PORT=5432

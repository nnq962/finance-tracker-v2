# Production settings: copy to deploy/.env in the production checkout and
# fill in (never commit it). Dev uses deploy/.env.dev, which `npm run db:up`
# (run in web/) creates by itself.

# --- Database -------------------------------------------------------------
# Owner of the schema; used only by migrations and backups.
POSTGRES_PASSWORD=change-me
# The role the app connects as (row read/write only).
APP_DB_PASSWORD=change-me
# Generate each with: openssl rand -hex 24

# --- Web app --------------------------------------------------------------
# Port on 127.0.0.1 for checking the app on this machine.
WEB_PORT=3010

# Firebase web config (public; baked into the build). Same values as
# web/.env.local, except the auth domain: use the app's own domain in production.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=timi.nnqlab.dev
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
# Google One Tap: the OAuth web client ID Firebase made for Google sign in
# (Google Cloud Console > APIs & Services > Credentials). Unset, no One Tap.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Absolute path to the Firebase Admin service-account JSON on this machine.
FIREBASE_CREDENTIALS_FILE=/absolute/path/to/firebase-admin.json

# --- Cloudflare Tunnel ----------------------------------------------------
# Token of a remotely-managed tunnel whose public hostname points to
# http://web:3000. Leave empty to run without the tunnel.
CLOUDFLARE_TUNNEL_TOKEN=

# --- Backups (deploy/scripts/backup.sh) ------------------------------------
# rclone remote for off-site copies; empty keeps backups on this machine only.
BACKUP_REMOTE=gdrive-crypt:
BACKUP_KEEP=14
BACKUP_REMOTE_DAYS=90

# Sentry error tracking (optional): the project's DSN from sentry.io › Project
# Settings › Client Keys. Empty leaves error tracking off.
NEXT_PUBLIC_SENTRY_DSN=

# The admin's Telegram bot (optional): the token from @BotFather and the chat
# it writes to. Deploys, backups, new users, Pro sales, server errors and the
# evening summary go there. OPS_SECRET (32+ characters, e.g. openssl rand -hex 32)
# lets the watcher on the other machine (deploy/watcher) ask for the summary.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
OPS_SECRET=

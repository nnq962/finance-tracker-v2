# The admin's Telegram bot: the same token and chat as in deploy/.env on the home server.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# The same OPS_SECRET as in deploy/.env, so the evening summary can be asked for.
OPS_SECRET=

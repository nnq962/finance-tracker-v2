NEXT_PUBLIC_FIREBASE_API_KEY=
# Local: <project-id>.firebaseapp.com. Production: finance.nnqlab.dev, served
# through the /__/auth rewrite in next.config.ts (see deploy/.env.example).
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Firebase Admin (server only). On Google-managed hosting, Application Default
# Credentials can be used instead of these service-account values.
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# PostgreSQL, as the finance_app role. `npm run db:up` adds this to .env.local.
DATABASE_URL=postgres://finance_app:<APP_DB_PASSWORD>@127.0.0.1:5432/finance

# The AI assistant's local model (Ollama). Production reaches it on the
# compose network; a dev machine needs a port to it.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e4b

# Plans. Admins (verified emails, comma separated) grant Pro by hand in
# Settings → Quản trị. payOS (my.payos.vn → Kênh thanh toán) sells it;
# checkout stays off until all three keys are set.
ADMIN_EMAILS=
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# Dictation through Whisper (whisper-large-v3-turbo) on Groq
# (console.groq.com → API Keys); the browser's recogniser until set.
GROQ_API_KEY=

# The AI assistant through Gemini (aistudio.google.com → Get API key); gemma
# on Ollama until set, and whenever Gemini fails.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Dev only: sign in at http://localhost:3000/api/dev/login?next=/transactions
# as a seeded sample user, without Google. Ignored by production builds and
# by requests not addressed to localhost.
DEV_LOGIN=
# The dev tunnel (deploy/scripts/dev-tunnel.sh): this machine's tunnel id
# (cloudflared tunnel create <name>; one per machine), its hostname, and for
# dev sign-in through it a secret of 32+ characters (openssl rand -hex 24) that the
# sign-in link carries once: /api/dev/login?key=<secret>&next=/overview.
DEV_TUNNEL_ID=
DEV_TUNNEL_HOST=
DEV_TUNNEL_KEY=
